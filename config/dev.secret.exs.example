import Config

# Resend API key for sending emails in development.
# Get yours at https://resend.com → API Keys.
# Before verifying a domain you can only send FROM onboarding@resend.dev
# and only TO your own verified email address.
config :crc, CRC.Mailer,
  adapter: Swoosh.Adapters.Resend,
  api_key: "re_YOUR_KEY_HERE"

# Resend requires an HTTP client — use Req (already a project dependency).
config :swoosh, :api_client, Swoosh.ApiClient.Req
